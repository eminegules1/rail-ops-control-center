# Copy to .env to override. Every value has a default in docker-compose.yml,
# so the stack starts without a .env file. These are local demo values only.

# PostgreSQL
POSTGRES_DB=incidents
POSTGRES_USER=rail_ops
POSTGRES_PASSWORD=rail_ops_local_only

# Signing key for the dashboard's login tokens: at least 32 characters. Leave it unset and the backend uses a
# random key, so everyone is signed out whenever the backend restarts. To keep sessions across restarts, uncomment
# it and use your own value (`openssl rand -hex 32` makes a good one). The sample below is public: do not reuse it.
# AUTH_JWT_SECRET=89cb7a1d4a2963d3ee14528ec0993d3250364f746bb1367f9af39caee4f22515

# Host ports (bound to 127.0.0.1)
POSTGRES_PORT=5432
REDIS_PORT=6379
# Kafka also advertises its host listener on this port (localhost:<KAFKA_PORT>)
KAFKA_PORT=9092
KAFKA_UI_PORT=8081
PRODUCER_PORT=8082
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Event producer
PRODUCER_INTERVAL_MS=2000
PRODUCER_DUPLICATE_RATIO=0.05
# Share of intentionally invalid messages (sent to the backend's dead-letter topic)
PRODUCER_INVALID_RATIO=0.02
